---
import Mark from './Mark.astro';
import Button from './Button.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
---
<header class="header" data-header>
  <a class="header__home" href={`${base}/`} aria-label="Tempro, home" aria-current={path === '/' ? 'page' : undefined}>
    <Mark size={30} />
    <span class="header__word" aria-hidden="true">tempro</span>
  </a>
  <nav class="header__nav" aria-label="Main">
    <ul>
      <li><a class="draw" href={`${base}/privacy/`} aria-current={path === '/privacy' ? 'page' : undefined}>Privacy</a></li>
      <li><a class="draw" href={site.repo} rel="noopener">GitHub</a></li>
    </ul>
    <Button href={site.download} class="header__cta" external>Download</Button>
  </nav>
</header>
