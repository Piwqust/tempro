{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempro",
  "version": "0.3.1",
  "identifier": "com.tempro.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tempro",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#ECECEC"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tempro",
    "copyright": "© 2026 Tempro",
    "category": "Productivity",
    "shortDescription": "Automatic time tracking",
    "longDescription": "Records what you worked on and where you rested, sorts it into projects and shows it by day, week, month, 3 months and year.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}